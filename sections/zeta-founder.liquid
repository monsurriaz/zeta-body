{%- comment -%}
  ZETA — Founder (#founder): 2-col editorial copy + dark media panel.
  Styles: custom.css (.zeta-founder).
{%- endcomment -%}

<section class="zeta zeta-founder" {{ section.shopify_attributes }}>
  <div class="zeta-founder__copy">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zeta-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="zeta-founder__h2">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.body != blank -%}
      <div class="zeta-founder__body">{{ section.settings.body }}</div>
    {%- endif -%}
    {%- if section.settings.sig_role != blank or section.settings.sig_name != blank -%}
      <div class="zeta-founder__sig">
        {%- if section.settings.sig_role != blank -%}
          <div class="zeta-founder__sig-role">{{ section.settings.sig_role | escape }}</div>
        {%- endif -%}
        {%- if section.settings.sig_name != blank -%}
          <div class="zeta-founder__sig-name">{{ section.settings.sig_name | escape }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.button_text != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="zeta-btn zeta-btn--outline zeta-founder__btn">{{ section.settings.button_text | escape }}</a>
    {%- endif -%}
  </div>

  <div class="zeta-founder__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(max-width: 960px) 100vw, 50vw', widths: '600,900,1200,1400', class: 'zeta-founder__img' }}
    {%- else -%}
      <span class="zeta-founder__media-hint">{{ section.settings.media_placeholder | default: 'Founder photo' | escape }}</span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Zeta Founder",
  "tag": "section",
  "class": "shopify-section--zeta-founder",
  "settings": [
    { "type": "header", "content": "Copy (left)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Founder" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Built from <em>winning and losing</em> the fight." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>I've been on both sides. The winning one. The losing one. In 2013, a grand mal seizure out of nowhere changed everything I knew about my own brain and body.</p><p>ZETA is the daily foundation I built when I refused to accept the drain as normal.</p>" },
    { "type": "text", "id": "sig_role", "label": "Signature role", "default": "Founder & CEO, ZETA Body" },
    { "type": "text", "id": "sig_name", "label": "Signature name", "default": "Zoe Karli" },
    { "type": "text", "id": "button_text", "label": "Button label", "default": "Read Our Story →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Media (right)" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "media_placeholder", "label": "Placeholder text", "default": "Founder photo — Zoe Karli" }
  ],
  "presets": [
    { "name": "Zeta Founder" }
  ]
}
{% endschema %}
