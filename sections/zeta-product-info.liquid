{%- comment -%}
  ZETA — Product Info (§5b, functional hero)
  Two-column: media (Impact product-gallery) left, editorial + buy box right.
  Everything is a reorderable block. Add-to-cart wraps Impact's <form is="product-form">
  so AJAX cart + cart-drawer sync work natively. Buy-related blocks (price, variant_picker,
  quantity, subscription, buy_buttons) are auto-grouped into the bordered buy box.
  Subscription = its own block; only renders when the product has selling plans.
  Styles: custom.css (.zeta-pdp).
{%- endcomment -%}

{%- capture product_form_id -%}product-form-{{ product.id }}-{{ section.id }}{%- endcapture -%}
{%- assign variant = product.selected_or_first_available_variant -%}
{%- assign variant_picker_block = section.blocks | where: 'type', 'variant_picker' | first -%}
{%- assign buybox_types = 'price,variant_picker,quantity,subscription,buy_buttons' | split: ',' -%}
{%- assign show_thumbs = section.settings.show_thumbnails -%}
{%- assign show_thumbs_mobile = section.settings.show_thumbnails_mobile -%}

{%- comment -%} Settings-dependent CSS (per the project rule, lives in the section, not custom.css) {%- endcomment -%}
<style>
  {%- unless show_thumbs -%}
    @media screen and (min-width: 901px) {
      #shopify-section-{{ section.id }} .zeta-gallery__thumbs-wrap { display: none; }
    }
  {%- endunless -%}
  {%- unless show_thumbs_mobile -%}
    @media screen and (max-width: 900px) {
      #shopify-section-{{ section.id }} .zeta-gallery__thumbs-wrap { display: none; }
    }
  {%- endunless -%}
</style>

<section class="zeta zeta-pdp {% if section.settings.column_alignment == 'sticky' %}zeta-pdp--sticky{% endif %}" {{ section.shopify_attributes }}>
  <product-rerender id="zeta-pdp-{{ product.id }}-{{ section.id }}" observe-form="{{ product_form_id }}" allow-partial-rerender class="zeta-pdp__grid">
    {%- comment -%} ---------- MEDIA (left) ---------- {%- endcomment -%}
    <div class="zeta-pdp__media">
      {%- if section.settings.media_badge != blank -%}
        <div class="zeta-pdp__media-badge">{{ section.settings.media_badge | escape }}</div>
      {%- endif -%}

      {%- if product.media.size > 0 -%}
        {%- assign default_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media -%}
        {%- assign thumbs_per_row = section.settings.thumbnails_per_row | default: 5 -%}
        {%- assign show_thumb_arrows = false -%}
        {%- if product.media.size > thumbs_per_row -%}{%- assign show_thumb_arrows = true -%}{%- endif -%}
        {%- assign render_thumbs = false -%}
        {%- if show_thumbs or show_thumbs_mobile -%}{%- assign render_thumbs = true -%}{%- endif -%}
        <zeta-gallery class="zeta-gallery zeta-gallery--{{ section.settings.main_media_ratio | default: 'fill' }} zeta-gallery--fit-{{ section.settings.main_media_fit | default: 'cover' }}">
          {%- comment -%} Main viewport {%- endcomment -%}
          <div class="zeta-gallery__stage">
            <div class="zeta-gallery__track">
              {%- for media in product.media -%}
                <div class="zeta-gallery__slide {% if media == default_media %}is-active{% endif %}" data-media-id="{{ media.id }}">
                  {{-
                    media
                    | image_url: width: 1400
                    | image_tag: loading: 'lazy', sizes: '(max-width: 900px) 100vw, 50vw', widths: '600,900,1200,1400', alt: media.alt | default: product.title
                  -}}
                </div>
              {%- endfor -%}
            </div>

            {%- if product.media.size > 1 -%}
              <button type="button" class="zeta-gallery__arrow zeta-gallery__arrow--prev" data-prev aria-label="{{ 'general.accessibility.previous' | t }}">{%- render 'icon' with 'chevron-left', direction_aware: true -%}</button>
              <button type="button" class="zeta-gallery__arrow zeta-gallery__arrow--next" data-next aria-label="{{ 'general.accessibility.next' | t }}">{%- render 'icon' with 'chevron-right', direction_aware: true -%}</button>
            {%- endif -%}
          </div>

          {%- comment -%} Thumbnails (skipped entirely when hidden on both breakpoints) {%- endcomment -%}
          {%- if product.media.size > 1 and render_thumbs -%}
            <div class="zeta-gallery__thumbs-wrap {% unless show_thumb_arrows %}zeta-gallery__thumbs-wrap--no-arrows{% endunless %}">
              {%- if show_thumb_arrows -%}
                <button type="button" class="zeta-gallery__thumb-arrow" data-thumb-prev aria-label="{{ 'general.accessibility.previous' | t }}">{%- render 'icon' with 'chevron-left', direction_aware: true -%}</button>
              {%- endif -%}
              <div class="zeta-gallery__thumbs" role="list" style="--zeta-thumbs-per-row: {{ thumbs_per_row }};">
                {%- for media in product.media -%}
                  <button type="button" class="zeta-gallery__thumb {% if media == default_media %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-current="{% if media == default_media %}true{% else %}false{% endif %}" aria-label="{{ 'general.accessibility.go_to_item' | t: index: forloop.index }}">
                    {{-
                      media
                      | image_url: width: 160
                      | image_tag: loading: 'lazy', sizes: '72px', widths: '72,144,216', alt: media.alt | default: product.title
                    -}}
                  </button>
                {%- endfor -%}
              </div>
              {%- if show_thumb_arrows -%}
                <button type="button" class="zeta-gallery__thumb-arrow" data-thumb-next aria-label="{{ 'general.accessibility.next' | t }}">{%- render 'icon' with 'chevron-right', direction_aware: true -%}</button>
              {%- endif -%}
            </div>
          {%- endif -%}
        </zeta-gallery>
      {%- else -%}
        <div class="zeta-pdp__media-placeholder">{{ product.title | default: 'Product image' | escape }}</div>
      {%- endif -%}
    </div>

    {%- comment -%}
      ---------- INFO (right) ----------
      Buy-box blocks (price/variant/quantity/subscription/buy_buttons) are collected into
      a single bordered container; presentational blocks render before/after it in order.
    {%- endcomment -%}
    <div class="zeta-pdp__info">
      {%- assign before_box = '' -%}
      {%- assign box_inner = '' -%}
      {%- assign after_box = '' -%}
      {%- assign box_started = false -%}

      {%- for block in section.blocks -%}
        {%- capture block_html -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            {%- render block -%}
            
          {%- when 'banner' -%}
            <div class="zeta-pdp__banner" {{ block.shopify_attributes }}>
              <span class="zeta-pdp__banner-name">{{ block.settings.name | default: product.title | escape }}</span>
              {%- if block.settings.sub != blank -%}
                <span class="zeta-pdp__banner-sub">{{ block.settings.sub | escape }}</span>
              {%- endif -%}
            </div>

          {%- when 'heading' -%}
            <h1 class="zeta-pdp__h1" {{ block.shopify_attributes }}>{{ block.settings.heading | newline_to_br }}</h1>

          {%- when 'lede' -%}
            <div class="zeta-pdp__lede" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

          {%- when 'rating' -%}
            <div class="zeta-pdp__stars" {{ block.shopify_attributes }}>
              {{ block.settings.stars | escape }}
              {%- if block.settings.label != blank -%}<span>{{ block.settings.label | escape }}</span>{%- endif -%}
            </div>

          {%- when 'price' -%}
            <div class="zeta-pdp__price" {{ block.shopify_attributes }}>
              {%- render 'price-list', product: product, variant: variant, form_id: product_form_id -%}
            </div>

          {%- when 'variant_picker' -%}
            <div class="zeta-pdp__variant-picker" {{ block.shopify_attributes }}>
              {%- render 'variant-picker', product: product, form_id: product_form_id, update_url: true, hide_sold_out_variants: block.settings.hide_sold_out_variants, block: block -%}
            </div>

          {%- when 'quantity' -%}
            {%- if product.available -%}
              <div class="zeta-pdp__quantity" {{ block.shopify_attributes }}>
                <label for="{{ product_form_id }}-quantity" class="zeta-pdp__quantity-label">{{ 'product.quantity.label' | t }}</label>
                <quantity-selector class="quantity-selector">
                  <button type="button" tabindex="-1" class="quantity-selector__button" aria-label="{{ 'product.quantity.decrease_quantity' | t }}">{% render 'icon' with 'minus', width: 10, height: 2 %}</button>
                  <input id="{{ product_form_id }}-quantity" type="number" is="quantity-input" inputmode="numeric" class="quantity-selector__input" name="quantity" form="{{ product_form_id }}" value="{{ variant.quantity_rule.min | default: 1 }}" min="{{ variant.quantity_rule.min }}" step="{{ variant.quantity_rule.increment }}" {% if variant.quantity_rule.max != nil %}max="{{ variant.quantity_rule.max }}"{% endif %} autocomplete="off">
                  <button type="button" tabindex="-1" class="quantity-selector__button" aria-label="{{ 'product.quantity.increase_quantity' | t }}">{% render 'icon' with 'plus', width: 10, height: 10 %}</button>
                </quantity-selector>
              </div>
            {%- endif -%}

          {%- when 'subscription' -%}
            {%- if product.selling_plan_groups.size > 0 -%}
              <div class="zeta-pdp__options" {{ block.shopify_attributes }}>
                <label class="zeta-pdp__option">
                  <input type="radio" name="selling_plan" form="{{ product_form_id }}" value="" checked class="zeta-pdp__radio-input">
                  <span class="zeta-pdp__radio" aria-hidden="true"></span>
                  <span class="zeta-pdp__option-text">
                    <span class="zeta-pdp__option-label">{{ block.settings.onetime_label | escape }}</span>
                    {%- if block.settings.onetime_sub != blank -%}<span class="zeta-pdp__option-sub">{{ block.settings.onetime_sub | escape }}</span>{%- endif -%}
                  </span>
                  <span class="zeta-pdp__option-price">{{ variant.price | money }}</span>
                </label>

                {%- comment -%} One row per selling plan (frequency), driven by the variant's allocations {%- endcomment -%}
                {%- for allocation in variant.selling_plan_allocations -%}
                  {%- assign plan = allocation.selling_plan -%}
                  {%- assign save_pct = 0 -%}
                  {%- if allocation.price < variant.price -%}
                    {%- assign save_pct = variant.price | minus: allocation.price | times: 100.0 | divided_by: variant.price | round -%}
                  {%- endif -%}
                  <label class="zeta-pdp__option">
                    <input type="radio" name="selling_plan" form="{{ product_form_id }}" value="{{ plan.id }}" class="zeta-pdp__radio-input">
                    <span class="zeta-pdp__radio" aria-hidden="true"></span>
                    <span class="zeta-pdp__option-text">
                      <span class="zeta-pdp__option-label">
                        {{ plan.name | escape }}
                        {%- if save_pct > 0 -%}<span class="zeta-pdp__option-badge">{{ save_pct }}% OFF</span>{%- endif -%}
                      </span>
                      {%- if block.settings.subscribe_sub != blank -%}<span class="zeta-pdp__option-sub">{{ block.settings.subscribe_sub | escape }}</span>{%- endif -%}
                    </span>
                    <span class="zeta-pdp__option-price">
                      {%- if allocation.price < variant.price -%}<s>{{ variant.price | money }}</s> {% endif -%}
                      {{ allocation.price | money }}
                    </span>
                  </label>
                {%- endfor -%}
              </div>
            {%- endif -%}

          {%- when 'buy_buttons' -%}
            <div class="zeta-pdp__buy" {{ block.shopify_attributes }}>
              {%- form 'product', product, is: 'product-form', id: product_form_id -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ variant.id }}"
                  {% if variant_picker_block != blank %}disabled{% endif %}
                >
                <buy-buttons class="zeta-pdp__buy-buttons" template="{{ product.template_suffix | escape }}" form="{{ product_form_id }}">
                  <button
                    type="submit"
                    class="zeta-pdp__atc"
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {%- if variant == null -%}
                      {{ 'product.general.unavailable_button' | t }}
                    {%- elsif variant.available -%}
                      {{ block.settings.button_label | default: 'Add to cart' }}
                    {%- else -%}
                      {{ 'product.general.sold_out_button' | t }}
                    {%- endif -%}
                  </button>
                </buy-buttons>

                {%- if block.settings.show_payment_button -%}
                  {{ form | payment_button }}
                {%- endif -%}
              {%- endform -%}

              {%- if block.settings.secondary_label != blank -%}
                <a href="{{ block.settings.secondary_link | default: '#' }}" class="zeta-pdp__atc-secondary">{{ block.settings.secondary_label | escape }}</a>
              {%- endif -%}
            </div>

          {%- when 'trust_badges' -%}
            {%- if block.settings.badges != blank -%}
              <div class="zeta-pdp__trust" {{ block.shopify_attributes }}>
                {%- assign badges = block.settings.badges | strip | newline_to_br | split: '<br />' -%}
                {%- for b in badges -%}
                  {%- assign b_clean = b | strip -%}
                  {%- if b_clean != blank -%}<span class="zeta-pdp__trust-badge">{{ b_clean | escape }}</span>{%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
        {%- endcase -%}
        {%- endcapture -%}

        {%- if buybox_types contains block.type -%}
          {%- assign box_started = true -%}
          {%- assign box_inner = box_inner | append: block_html -%}
        {%- elsif box_started -%}
          {%- assign after_box = after_box | append: block_html -%}
        {%- else -%}
          {%- assign before_box = before_box | append: block_html -%}
        {%- endif -%}
      {%- endfor -%}

      {{ before_box }}
      {%- if box_inner != blank -%}<div class="zeta-pdp__buybox">{{ box_inner }}</div>{%- endif -%}
      {{ after_box }}
    </div>
  </product-rerender>
</section>

<script>
  (() => {
    if (window.customElements.get('zeta-gallery')) return;
    class ZetaGallery extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.zeta-gallery__track');
        this.slides = Array.from(this.querySelectorAll('.zeta-gallery__slide'));
        this.thumbs = Array.from(this.querySelectorAll('.zeta-gallery__thumb'));
        this.thumbStrip = this.querySelector('.zeta-gallery__thumbs');
        if (!this.track || this.slides.length === 0) return;
        this.index = this.slides.findIndex((s) => s.classList.contains('is-active'));
        if (this.index < 0) this.index = 0;

        const prev = this.querySelector('[data-prev]');
        const next = this.querySelector('[data-next]');
        if (prev) prev.addEventListener('click', () => this.go(this.index - 1));
        if (next) next.addEventListener('click', () => this.go(this.index + 1));
        this.thumbs.forEach((t, i) => t.addEventListener('click', () => this.go(i)));

        const tp = this.querySelector('[data-thumb-prev]');
        const tn = this.querySelector('[data-thumb-next]');
        if (tp) tp.addEventListener('click', () => this.scrollThumbs(-1));
        if (tn) tn.addEventListener('click', () => this.scrollThumbs(1));

        // Basic swipe on the main stage
        const stage = this.querySelector('.zeta-gallery__stage');
        let x0 = null;
        if (stage) {
          stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
          stage.addEventListener('touchend', (e) => {
            if (x0 === null) return;
            const dx = e.changedTouches[0].clientX - x0;
            if (Math.abs(dx) > 40) this.go(this.index + (dx < 0 ? 1 : -1));
            x0 = null;
          }, { passive: true });
        }

        // Sync to Impact variant changes (presentation only)
        this._onVariant = (e) => {
          const d = (e && e.detail) || {};
          const v = d.variant || d;
          const mid = v && (v.featured_media_id || (v.featured_media && v.featured_media.id));
          if (!mid) return;
          const i = this.slides.findIndex((s) => String(s.dataset.mediaId) === String(mid));
          if (i >= 0) this.go(i);
        };
        document.addEventListener('variant:change', this._onVariant);

        this.render();
      }
      disconnectedCallback() {
        if (this._onVariant) document.removeEventListener('variant:change', this._onVariant);
      }
      go(i) {
        this.index = Math.max(0, Math.min(this.slides.length - 1, i));
        this.render();
      }
      scrollThumbs(dir) {
        if (this.thumbStrip) this.thumbStrip.scrollBy({ left: dir * this.thumbStrip.clientWidth * 0.8, behavior: 'smooth' });
      }
      render() {
        this.track.style.transform = 'translateX(' + (this.index * -100) + '%)';
        this.slides.forEach((s, i) => s.classList.toggle('is-active', i === this.index));
        this.thumbs.forEach((t, i) => {
          const on = i === this.index;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-current', on ? 'true' : 'false');
        });
        const at = this.thumbs[this.index];
        if (at) at.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
      }
    }
    window.customElements.define('zeta-gallery', ZetaGallery);
  })();
</script>

{% schema %}
{
  "name": "Zeta Product Info",
  "tag": "section",
  "class": "shopify-section--zeta-pdp",
  "settings": [
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "column_alignment",
      "label": "Column height",
      "info": "Sticky: the shorter column stays pinned while the taller column scrolls.",
      "options": [
        { "value": "straight", "label": "Straight (equal height)" },
        { "value": "sticky", "label": "Sticky" }
      ],
      "default": "straight"
    },
    { "type": "header", "content": "Media gallery" },
    { "type": "text", "id": "media_badge", "label": "Media badge", "info": "Shown top-right over the gallery. Leave blank to hide.", "default": "NSF Certified for Sport" },
    {
      "type": "select",
      "id": "main_media_ratio",
      "label": "Main image ratio",
      "options": [
        { "value": "fill", "label": "Natural (fill column)" },
        { "value": "portrait", "label": "Portrait (4:5)" },
        { "value": "square", "label": "Square (1:1)" }
      ],
      "default": "fill"
    },
    {
      "type": "select",
      "id": "main_media_fit",
      "label": "Main image fit",
      "options": [
        { "value": "cover", "label": "Cover (fill, may crop)" },
        { "value": "contain", "label": "Contain (show whole image)" }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "thumbnails_per_row",
      "label": "Thumbnails per row",
      "info": "Arrows appear only when there are more images than this.",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 5
    },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show thumbnails (desktop)", "default": true },
    { "type": "checkbox", "id": "show_thumbnails_mobile", "label": "Show thumbnails (mobile)", "default": true }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "banner",
      "name": "Product banner",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "info": "Leave blank to use the product title.", "default": "Zeta Creatine" },
        { "type": "text", "id": "sub", "label": "Subtext", "default": "The World's Most Studied Supplement" }
      ]
    },
    {
      "type": "heading",
      "name": "Headline",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "heading", "label": "Headline", "info": "Line breaks (Enter) become new lines. Use <em>…</em> for teal emphasis.", "default": "<em>Strength.</em>\nBrain. Everyday." }
      ]
    },
    {
      "type": "lede",
      "name": "Lede",
      "limit": 1,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Creatine isn't just a gym thing anymore. Ongoing research shows it does as much for your brain as it does for your muscle. NSF Certified for Sport.</p>" }
      ]
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "stars", "label": "Stars", "default": "★★★★★" },
        { "type": "text", "id": "label", "label": "Label", "default": "4.9 · 312 reviews" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows the live product price. Use when the product has no subscription options." }
      ]
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "hide_sold_out_variants", "label": "Hide sold out variants", "default": false },
        { "type": "checkbox", "id": "stack_blocks", "label": "Stack options", "default": true },
        { "type": "select", "id": "selector_style", "label": "Selector style", "options": [ { "value": "block", "label": "Block" }, { "value": "dropdown", "label": "Dropdown" } ], "default": "block" },
        { "type": "select", "id": "swatch_selector_style", "label": "Swatch style", "options": [ { "value": "swatch", "label": "Swatch" }, { "value": "swatch_dropdown", "label": "Swatch dropdown" } ], "default": "swatch" },
        { "type": "text", "id": "variant_image_options", "label": "Variant image options", "info": "Option names that switch media (comma-separated)." },
        { "type": "page", "id": "size_chart_page", "label": "Size chart page" }
      ]
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Quantity selector wired to the add-to-cart form." }
      ]
    },
    {
      "type": "subscription",
      "name": "Subscription",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "One-time / Subscribe options. Only shown when the product has selling plans (subscriptions)." },
        { "type": "text", "id": "onetime_label", "label": "One-time label", "default": "One bottle, this time" },
        { "type": "text", "id": "onetime_sub", "label": "One-time subtext", "default": "300g powder · 60 servings · 30-day supply" },
        { "type": "text", "id": "subscribe_label", "label": "Subscribe label", "default": "Subscribe & Save" },
        { "type": "text", "id": "subscribe_sub", "label": "Subscribe subtext", "default": "Free shipping · Pause or cancel any time" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "button_label", "label": "Add-to-cart label", "default": "BUY ZETA CREATINE" },
        { "type": "checkbox", "id": "show_payment_button", "label": "Show dynamic checkout button", "default": false },
        { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "PAIR WITH MINOS · SAVE 10%" },
        { "type": "url", "id": "secondary_link", "label": "Secondary button link" }
      ]
    },
    {
      "type": "trust_badges",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        { "type": "textarea", "id": "badges", "label": "Badges", "info": "One per line.", "default": "NSF Certified for Sport\n5g Creatine Monohydrate\ncGMP Manufactured" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zeta Product Info",
      "blocks": [
        { "type": "banner" },
        { "type": "heading" },
        { "type": "lede" },
        { "type": "rating" },
        { "type": "subscription" },
        { "type": "variant_picker" },
        { "type": "buy_buttons" },
        { "type": "trust_badges" }
      ]
    }
  ]
}
{% endschema %}
