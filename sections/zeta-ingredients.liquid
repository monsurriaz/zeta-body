{%- comment -%}
  ZETA — Ingredient Tiles (.ingredients): eyebrow + heading + tile grid.
  Tiles are blocks. Styles: custom.css (.zeta-ingredients).
{%- endcomment -%}

<section class="zeta zeta-ingredients" {{ section.shopify_attributes }}>
  <div class="zeta-ingredients__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zeta-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="zeta-section-h2 zeta-section-h2--flush">{{ section.settings.heading }}</h2>
    {%- endif -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="zeta-ingredients__grid">
      {%- for block in section.blocks -%}
        <div class="zeta-ingredients__tile" {{ block.shopify_attributes }}>
          {%- if block.settings.tag != blank -%}
            <span class="zeta-ingredients__tag">{{ block.settings.tag | escape }}</span>
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <div class="zeta-ingredients__name">{{ block.settings.name }}</div>
          {%- endif -%}
          {%- if block.settings.source != blank -%}
            <div class="zeta-ingredients__source">{{ block.settings.source | escape }}</div>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <div class="zeta-ingredients__body">{{ block.settings.body }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Zeta Ingredient Tiles",
  "tag": "section",
  "class": "shopify-section--zeta-ingredients",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What's inside" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "One ingredient. <em>~700 clinical trials</em> behind it." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Ingredient tile",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "info": "Optional bronze label." },
        { "type": "inline_richtext", "id": "name", "label": "Name", "default": "Creatine Monohydrate" },
        { "type": "text", "id": "source", "label": "Source line", "default": "5g per serving · pure · extensively studied" },
        { "type": "richtext", "id": "body", "label": "Body", "default": "<p>The most studied performance supplement in history. 5g. One ingredient. Nothing else.*</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zeta Ingredient Tiles",
      "blocks": [
        { "type": "tile", "settings": { "tag": "The Molecule", "name": "Creatine Monohydrate", "source": "5g per serving · pure · extensively studied", "body": "<p>The most studied performance supplement in history. Creatine stores phosphate groups as phosphocreatine, regenerating ATP — the primary fuel for muscle contraction and brain function. 5g. One ingredient. Nothing else.*</p>" } },
        { "type": "tile", "settings": { "tag": "The Standard", "name": "NSF Certified for Sport®", "source": "Third-party tested · every lot · 270+ banned substances", "body": "<p>Every single production lot independently tested for banned substances — the certification pro athletes and Olympic teams require. Few competitor creatines bother. We do.*</p>" } }
      ]
    }
  ]
}
{% endschema %}
