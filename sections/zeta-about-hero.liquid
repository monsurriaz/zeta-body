{%- comment -%}
  ZETA — About Hero (.zeta-about-hero): vertical (top→bottom) hero for the About page.
  Stacked: eyebrow (optional) → title → paragraph → video. References the Home Hero look
  (big serif title, our title/eyebrow size system) but simpler and single-column.
  The video reuses the shared <zeta-video-play> element + .zeta-video__* styles.
  External (YouTube/Vimeo) embeds directly — no custom placeholder/button, just the provider's
  own player. Self-hosted video shows a click-to-play button over a thumbnail (merchant poster,
  else the video's own preview frame). With neither set, the frame is a styled placeholder.
  Styles: custom.css (.zeta-about-hero, reusing .zeta-video__frame).
{%- endcomment -%}

{%- assign hosted = section.settings.video -%}
{%- assign vid = section.settings.video_url -%}
{%- assign embed = '' -%}
{%- if hosted == blank and vid != blank -%}
  {%- if vid.type == 'youtube' -%}
    {%- assign embed = 'https://www.youtube.com/embed/' | append: vid.id | append: '?rel=0' -%}
  {%- elsif vid.type == 'vimeo' -%}
    {%- assign embed = 'https://player.vimeo.com/video/' | append: vid.id -%}
  {%- endif -%}
{%- endif -%}
{%- assign poster_image = section.settings.poster -%}
{%- if poster_image == blank and hosted != blank -%}
  {%- assign poster_image = hosted.preview_image -%}
{%- endif -%}

<section class="zeta zeta-about-hero zeta-about-hero--align-{{ section.settings.text_align | default: 'center' }}" style="background-color: {{ section.settings.section_bg }};" {{ section.shopify_attributes }}>
  <div class="zeta-about-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="zeta-section-eyebrow zeta-eyebrow-size--{{ section.settings.eyebrow_size | default: 'small' }}">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="zeta-about-hero__h1 zeta-title zeta-title--{{ section.settings.heading_size | default: 'large' }}">{{ section.settings.heading | newline_to_br }}</h1>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="zeta-about-hero__body">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.show_video -%}
      {%- if embed != blank -%}
        <div class="zeta-video__frame zeta-video__frame--embed zeta-about-hero__frame">
          <iframe class="zeta-video__iframe" src="{{ embed }}" title="{{ section.settings.overlay_label | default: 'Video' | escape }}" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy" frameborder="0"></iframe>
        </div>
      {%- else -%}
        {%- assign has_video = false -%}
        {%- if hosted != blank -%}{%- assign has_video = true -%}{%- endif -%}
        <zeta-video-play class="zeta-video__frame zeta-about-hero__frame">
          {%- if hosted != blank -%}
            <video class="zeta-video__native" playsinline preload="none"{% if poster_image != blank %} poster="{{ poster_image | image_url: width: 1400 }}"{% endif %} data-native>
              {%- for source in hosted.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
          {%- elsif poster_image != blank -%}
            <img class="zeta-video__poster" src="{{ poster_image | image_url: width: 1400 }}" alt="{{ section.settings.overlay_label | escape }}" loading="lazy" width="{{ poster_image.width }}" height="{{ poster_image.height }}">
          {%- endif -%}
          <button type="button" class="zeta-video__play" aria-label="{{ section.settings.overlay_label | default: 'Play video' | escape }}"{% unless has_video %} disabled{% endunless %} data-play></button>
          {%- if section.settings.overlay_label != blank -%}
            <span class="zeta-video__label">{{ section.settings.overlay_label | escape }}</span>
          {%- endif -%}
        </zeta-video-play>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    if (window.customElements.get('zeta-video-play')) return;
    class ZetaVideoPlay extends HTMLElement {
      connectedCallback() {
        const btn = this.querySelector('[data-play]');
        const native = this.querySelector('[data-native]');
        if (!btn || !native || this._bound) return; /* nothing to play — decorative placeholder */
        this._bound = true;
        btn.addEventListener('click', () => {
          btn.remove();
          const label = this.querySelector('.zeta-video__label');
          if (label) label.remove();
          native.setAttribute('controls', '');
          native.classList.add('is-playing');
          const p = native.play();
          if (p && p.catch) p.catch(() => {});
        });
      }
    }
    window.customElements.define('zeta-video-play', ZetaVideoPlay);
  })();
</script>

{% schema %}
{
  "name": "Zeta About Hero",
  "tag": "section",
  "class": "shopify-section--zeta-about-hero",
  "settings": [
    { "type": "color", "id": "section_bg", "label": "Section background", "default": "#FFFFFF" },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" }
      ],
      "default": "center"
    },
    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Optional. Leave blank to hide.", "default": "About ZETA" },
    { "type": "select", "id": "eyebrow_size", "label": "Eyebrow size", "options": [ { "value": "medium", "label": "Medium" }, { "value": "small", "label": "Small" } ], "default": "small" },
    { "type": "textarea", "id": "heading", "label": "Title", "info": "Line breaks (Enter) become new lines. Use <em>…</em> for teal emphasis.", "default": "Built for the way\nyou <em>actually live.</em>" },
    { "type": "select", "id": "heading_size", "label": "Title size", "options": [ { "value": "large", "label": "Large" }, { "value": "medium", "label": "Medium" }, { "value": "small", "label": "Small" } ], "default": "large" },
    { "type": "richtext", "id": "body", "label": "Paragraph", "default": "<p>ZETA started with a simple idea: your brain and body deserve the same standard of care you bring to everything else. No compromises, no filler — just what the science supports, made to fit a real life.</p>" },
    { "type": "header", "content": "Video" },
    { "type": "checkbox", "id": "show_video", "label": "Show video", "default": true },
    { "type": "video", "id": "video", "label": "Self-hosted video", "info": "Upload a Shopify-hosted video. Takes priority over the external link below." },
    { "type": "video_url", "id": "video_url", "label": "External video link", "accept": ["youtube", "vimeo"], "info": "YouTube or Vimeo — embeds directly (used only if no self-hosted video is set). Leave both blank to show a styled placeholder." },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Optional thumbnail shown before play (self-hosted video only). If left blank, the video's own preview frame is used." },
    { "type": "text", "id": "overlay_label", "label": "Overlay label", "default": "Watch our story" }
  ],
  "presets": [
    { "name": "Zeta About Hero" }
  ]
}
{% endschema %}
