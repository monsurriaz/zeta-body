    "timeline": {
      "type": "zeta-timeline",
      "blocks": {
        "w1": {
          "type": "phase",
          "settings": {
            "label": "Week 1",
            "title": "Quiet start.",
            "body": "<p>Cell-level antioxidant work begins. Nothing you feel yet — but that's the point. Real longevity work runs quiet.</p>"
