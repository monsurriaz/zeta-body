    "timeline": {
      "type": "zeta-timeline",
      "blocks": {
        "w1": {
          "type": "phase",
          "settings": {
            "label": "Week 1–2",
            "title": "The beginning.",
            "body": "<p>In a 100-person Randomized Controlled Trial (RCT), B. lactis HN019® significantly reduced whole-gut transit time within 14 days. If things have been slow, this is usually the first thing you feel.</p>"
          }
        },
        "m1": {
          "type": "phase",
          "settings": {
            "label": "Week 2–4",
            "title": "Microecology shifts.",
            "body": "<p>Beneficial bacteria — bifidobacteria and lactobacilli — begin to rise. The microbiome moves toward balance. Less bloating, less unpredictability. More consistency.</p>"
          }
        },
        "m3": {
          "type": "phase",
          "settings": {
            "label": "Month 1–2",
            "title": "Immune support builds.",
            "body": "<p>About 70% of your immune system lives in the gut. Bowel regularity improves. Lactose digestion gets easier. The gut-immune axis starts working the way it's supposed to.</p>"
          }
        },
        "y1": {
          "type": "phase",
          "settings": {
            "label": "Ongoing",
            "title": "Foundation, not just function.",
            "body": "<p>The microbiome underpins energy, mood, immune response, and systemic inflammation. You're not just addressing digestion. You're maintaining the foundation everything else runs on.</p>"
          }
        }
      },
