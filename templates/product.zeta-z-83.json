      "type": "zeta-ingredients",
      "blocks": {
        "i1": {
          "type": "tile",
          "settings": {
            "featured": false,
            "icon": "<svg class=\"leaf-svg\" viewBox=\"0 0 60 60\"><path d=\"M30 5 C20 20, 14 35, 14 45 C14 52, 22 56, 30 56 C38 56, 46 52, 46 45 C46 35, 40 20, 30 5 Z\" fill=\"none\" stroke=\"#006E73\" stroke-width=\"1.5\"/><path d=\"M30 12 L30 50\" stroke=\"#006E73\" stroke-width=\"1\"/></svg>",
